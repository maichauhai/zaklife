    "draft",
    "scheduled",
    "approved",
    "posted",
    "missed",
    "failed"
  ],
  "automationHeartbeatFields": [
    "name",
    "status",
    "last_check_at",
    "last_result",
    "updated_at",
    "stale_after_minutes"
  ],
  "requiredStaticFiles": [
    "index.html",
